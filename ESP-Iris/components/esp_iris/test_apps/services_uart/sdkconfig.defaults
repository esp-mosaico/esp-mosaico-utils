CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_EXPERIMENTAL_FEATURES=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../services_usb/partitions.csv"
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Stock monitor and Iris 0.2 share the standard printable console contract.
CONFIG_ESP_IRIS_TRANSPORT_UART=y
CONFIG_ESP_IRIS_UART_NUM=0
CONFIG_ESP_IRIS_UART_BAUDRATE=115200
CONFIG_ESP_IRIS_MEDIA_LATEST_BYTES=3840
CONFIG_ESP_IRIS_MAX_RPC_HANDLERS=12
CONFIG_ESP_IRIS_MAX_FILE_VOLUMES=4
CONFIG_ESP_IRIS_TASK_STACK_SIZE=3328

CONFIG_ESP_IRIS_FIRMWARE_ROLE=1
